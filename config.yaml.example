# ==============================================================================
# MailBaby Configuration Example (config.yaml.example)
# High-performance, message-queue-driven email sending service in Go
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Application Configuration (App)
# ------------------------------------------------------------------------------
app:
  # Application service name
  name: "mailbaby"
  # Environment mode: development | test | staging | production
  env: "development"
  # Enable debug mode
  debug: true
  # Graceful shutdown timeout
  shutdown_timeout: "10s"

# ------------------------------------------------------------------------------
# 2. Unified HTTP Server Configuration (Server - Metrics / Health / Pprof)
# ------------------------------------------------------------------------------
server:
  # Host address to bind
  host: "0.0.0.0"
  # Port to listen on
  port: 8080
  # HTTP request read timeout
  read_timeout: "10s"
  # HTTP response write timeout
  write_timeout: "10s"
  # Keep-alive idle connection timeout
  idle_timeout: "30s"

# ------------------------------------------------------------------------------
# 3. Logging System Configuration (Log)
# ------------------------------------------------------------------------------
log:
  # Log level: trace | debug | info | warn | error | fatal | panic
  level: "info"
  # Output format: json | text | console | logfmt
  format: "text"
  # Output target: stdout | stderr | file | both
  output: "stdout"
  # Log file destination path (when output is 'file' or 'both')
  file_path: "./logs/mailbaby.log"
  # Maximum size of a single log file in MB before rotation
  max_size: 100
  # Maximum number of rotated log backup files to retain
  max_backups: 5
  # Maximum age (in days) to retain rotated log files
  max_age: 7
  # Enable gzip compression for rotated log files
  compress: true
  # Include caller file name and line number
  show_caller: false
  # Minimum level threshold to include stacktraces: none | warn | error | panic
  show_stacktrace: "error"
  # Custom timestamp layout (e.g. 2006-01-02 15:04:05 or RFC3339, empty for default)
  time_format: ""
  # Enable non-blocking asynchronous log writing
  async: false
  # Buffer size for async log channel
  buffer_size: 4096

# ------------------------------------------------------------------------------
# 4. SMTP Multi-Account Configuration (SMTP)
# Multiple SMTP accounts can be declared and selected per email message.
# A "default" account is required.
# ------------------------------------------------------------------------------
smtp:
  # Default SMTP sending account (required)
  default:
    # SMTP server host (e.g. smtp.gmail.com, smtp.office365.com, postfix relay)
    host: "smtp.example.com"
    # SMTP server port: 465 (SSL/TLS), 587 (STARTTLS), 25 (Plain / Relay)
    port: 587
    # Authentication username or login email address
    username: "noreply@example.com"
    # Authentication password, app password, or API key
    password: "your_smtp_password_or_token"

    # Default envelope sender address
    from: "noreply@example.com"
    # Default sender display name (optional)
    from_name: "MailBaby Notification"
    # Reply-to address (optional)
    reply_to: "support@example.com"

    # Encryption mode:
    #   - Auto: Automatic selection (port 465 uses SSL/TLS, others use STARTTLS)
    #   - SSL / TLS: Direct TLS connection on dial (typically port 465)
    #   - STARTTLS: Plain connection upgraded via STARTTLS command (typically port 587 / 25)
    #   - None: Plaintext connection without encryption (internal relay/testing only)
    encryption: "Auto"

    # Skip SSL/TLS certificate verification (for self-signed internal certs)
    insecure_skip_verify: false

    # HELO / EHLO greeting domain (defaults to local hostname if empty)
    helo_hostname: ""

    # SASL Authentication Mechanism:
    #   - Auto: Negotiate highest security supported by server
    #   - PLAIN: SASL PLAIN
    #   - LOGIN: SASL LOGIN
    #   - CRAM-MD5: SASL CRAM-MD5
    #   - None: No authentication (open relay)
    auth_type: "Auto"

    # Connection and delivery timeouts
    connect_timeout: "10s"
    send_timeout: "30s"
    keep_alive: "30s"

    # SMTP Connection Pool Management
    pool:
      # Maximum number of idle connections kept open in pool
      max_idle_conns: 5
      # Maximum number of concurrent active connections
      max_open_conns: 20
      # Maximum lifetime of an idle connection before closing
      idle_timeout: "60s"

    # Rate Limiting & Safety Controls
    rate_limit:
      # Maximum sending rate in emails per second (<=0 means unlimited; hard-capped at 10000)
      emails_per_second: 50
      # Maximum recipients allowed per single email message (0 means unlimited)
      max_recipients_per_email: 50
      # Maximum email payload size in bytes (0 = unlimited; default 15MB)
      email_size_limit: 15728640

  # Optional secondary account: Marketing emails
  # marketing:
  #   host: "smtp.mailgun.org"
  #   port: 587
  #   username: "postmaster@mg.example.com"
  #   password: "marketing_api_key"
  #   from: "marketing@news.example.com"
  #   from_name: "MailBaby Marketing"
  #   encryption: "STARTTLS"
  #   rate_limit:
  #     emails_per_second: 20
  #     max_recipients_per_email: 100

  # Optional secondary account: Ops Alerts
  # alert:
  #   host: "smtp.sendgrid.net"
  #   port: 465
  #   username: "apikey"
  #   password: "sendgrid_api_key"
  #   from: "alert@monitor.example.com"
  #   from_name: "Ops Alert System"
  #   encryption: "SSL"

# ------------------------------------------------------------------------------
# 5. Message Queue Configuration (Queue)
# ------------------------------------------------------------------------------
queue:
  # Active queue driver:
  # Supported: memory | rabbitmq | kafka | redis | rocketmq | nats | pulsar | sqs
  driver: "memory"

  # Consumer worker concurrency and retry policies
  # Number of concurrent worker goroutines
  concurrency: 10
  # Maximum retry attempts before routing to Dead Letter Queue (DLQ)
  max_retries: 3
  # Retry backoff interval
  retry_interval: "5s"
  # QoS prefetch message count
  prefetch_count: 10
  # Batch processing size
  batch_size: 1

  # ----------------------------------------------------------------------------
  # 5.1 RabbitMQ (AMQP 0-9-1) Driver Settings
  # ----------------------------------------------------------------------------
  rabbitmq:
    # Full AMQP URL (if set, overrides individual host/port fields)
    url: "amqp://guest:guest@127.0.0.1:5672/"
    host: "127.0.0.1"
    port: 5672
    username: "guest"
    password: "guest"
    vhost: "/"
    # Queue name to consume from
    queue: "mailbaby_tasks"
    # Exchange name
    exchange: "mailbaby_exchange"
    # Routing key
    routing_key: "mail.send.#"
    # Queue and exchange durability
    durable: true
    # Auto-delete queue when no consumers remain
    auto_delete: false
    # Exclusive queue access
    exclusive: false
    # Auto-acknowledge messages (false recommended for at-least-once delivery)
    auto_ack: false
    # Channel prefetch count
    prefetch_count: 10
    # TLS options
    tls:
      enable: false
      insecure_skip_verify: false

  # ----------------------------------------------------------------------------
  # 5.2 Apache Kafka Driver Settings
  # ----------------------------------------------------------------------------
  kafka:
    # Kafka broker addresses
    brokers:
      - "127.0.0.1:9092"
    # Topic name
    topic: "mailbaby_tasks"
    # Consumer Group ID
    group_id: "mailbaby_consumer_group"
    # Client ID
    client_id: "mailbaby_worker"
    # Kafka protocol version
    version: "3.4.0"
    # Initial offset reset strategy: oldest | newest
    initial_offset: "newest"
    # Enable automatic offset commits
    auto_commit: false
    # SASL Authentication
    sasl:
      enable: false
      # Mechanism: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI
      mechanism: "PLAIN"
      user: ""
      password: ""
    # TLS options
    tls:
      enable: false
      insecure_skip_verify: false

  # ----------------------------------------------------------------------------
  # 5.3 Redis (Stream / List / PubSub) Driver Settings
  # ----------------------------------------------------------------------------
  redis:
    # Redis node addresses (single host or cluster/sentinel list)
    addrs:
      - "127.0.0.1:6379"
    # Single node host and port
    host: "127.0.0.1"
    port: 6379
    # Redis ACL username (Redis 6+)
    username: ""
    # Redis access password
    password: ""
    # Database index
    db: 0
    # Sentinel master name (if running in Sentinel mode)
    master_name: ""
    # Operating mode: stream (recommended for ACK support) | list | pubsub
    mode: "stream"
    # Redis key or Stream name
    key: "mailbaby:queue:email"
    # Consumer group name (for stream mode)
    group: "mailbaby_consumer_group"
    # Consumer identifier name
    consumer: "worker_node_1"
    # Blocking timeout when waiting for messages
    block_time: "2s"
    # Maximum stream retention length (0 means unlimited)
    max_len: 100000

  # ----------------------------------------------------------------------------
  # 5.4 Apache RocketMQ Driver Settings
  # ----------------------------------------------------------------------------
  rocketmq:
    # NameServer addresses
    name_servers:
      - "127.0.0.1:9876"
    # Topic name
    topic: "mailbaby_topic"
    # Consumer Group
    group: "mailbaby_group"
    # Access credentials (for ACL or Cloud instances)
    access_key: ""
    secret_key: ""
    # STS temporary security token
    security_token: ""
    # Instance namespace
    namespace: ""
    # Consume in strict FIFO order
    consume_orderly: false

  # ----------------------------------------------------------------------------
  # 5.5 NATS / JetStream Driver Settings
  # ----------------------------------------------------------------------------
  nats:
    # NATS server addresses
    servers:
      - "nats://127.0.0.1:4222"
    # Subject name
    subject: "mailbaby.task.send"
    # Queue group for load balancing
    queue_group: "mailbaby_workers"
    # Enable JetStream persistence
    jetstream: true
    # JetStream Stream name
    stream: "MAILBABY_STREAM"
    # Durable consumer name
    durable: "mailbaby_worker_consumer"
    # Credentials (choose token, user/pass, or creds_file)
    token: ""
    username: ""
    password: ""
    creds_file: ""

  # ----------------------------------------------------------------------------
  # 5.6 Apache Pulsar Driver Settings
  # ----------------------------------------------------------------------------
  pulsar:
    # Pulsar broker service URL
    url: "pulsar://127.0.0.1:6650"
    # Topic name
    topic: "persistent://public/default/mailbaby_tasks"
    # Subscription Name
    subscription_name: "mailbaby_subscription"
    # Subscription Mode: Exclusive | Shared | Failover | Key_Shared
    subscription_type: "Shared"
    # JWT authentication token
    auth_token: ""

  # ----------------------------------------------------------------------------
  # 5.7 AWS SQS Driver Settings
  # ----------------------------------------------------------------------------
  sqs:
    # AWS Region
    region: "us-east-1"
    # SQS Queue full URL
    queue_url: "https://sqs.us-east-1.amazonaws.com/123456789012/mailbaby-queue"
    # AWS Credentials (leave empty to use default AWS credentials chain / IAM Role)
    access_key_id: ""
    secret_access_key: ""
    session_token: ""
    # Custom endpoint (e.g. for LocalStack testing: http://127.0.0.1:4566)
    endpoint: ""
    # SQS long polling wait duration in seconds (0~20)
    wait_time_seconds: 20
    # Visibility timeout in seconds
    visibility_timeout: 30
    # Maximum batch message count per receive call (1~10)
    max_number_of_messages: 10

  # ----------------------------------------------------------------------------
  # 5.8 In-Memory Queue Driver Settings
  # ----------------------------------------------------------------------------
  memory:
    # Go channel buffer size
    buffer_size: 1024

# ------------------------------------------------------------------------------
# 6. Metrics & Monitoring Configuration (Metrics)
# ------------------------------------------------------------------------------
metrics:
  # Enable metrics collection and exporter
  enabled: true
  # Metrics provider: prometheus | statsd | expvar | none
  provider: "prometheus"
  # HTTP metrics endpoint path
  path: "/metrics"

  # Collect Go runtime memory, GC, and goroutine statistics
  collect_runtime: true
  # Collect queue backlog, process latency, and throughput statistics
  collect_queue_stats: true
  # Collect SMTP connection pool, delivery latency, and success/failure counters
  collect_smtp_stats: true

  # StatsD client settings (active when provider is 'statsd')
  statsd:
    address: "127.0.0.1:8125"
    prefix: "mailbaby."
    flush_interval: "100ms"

  # Prometheus PushGateway settings (for ephemeral or batch workloads)
  pushgateway:
    enabled: false
    url: "http://127.0.0.1:9091"
    job: "mailbaby_worker"
    interval: "15s"
    basic_auth:
      username: ""
      password: ""

  # Custom static labels added to all metrics (e.g. cluster, region)
  custom_labels:
    service: "mailbaby"

  # Latency histogram buckets in seconds
  histogram_buckets: [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10]

# ------------------------------------------------------------------------------
# 7. Comprehensive Observability Configuration (Tracing / Health / Pprof)
# ------------------------------------------------------------------------------
observability:
  # 7.1 Distributed Tracing (Tracing)
  tracing:
    # Enable distributed tracing
    enabled: false
    # Tracing provider: otlp | jaeger | zipkin | stdout | none
    provider: "otlp"
    # Collector endpoint (e.g. OTLP gRPC 4317, OTLP HTTP 4318, Jaeger 6831)
    endpoint: "localhost:4317"
    # Skip TLS encryption (for local/testing environments)
    insecure: true
    # Sampling rate: 0.0 to 1.0 (1.0 = 100% trace sampling)
    sample_rate: 1.0
    # Service identifier name (defaults to app.name if empty)
    service_name: "mailbaby"
    # Batch export timeout
    batch_timeout: "5s"
    # Maximum span queue capacity in memory
    max_queue_size: 2048
    # Export timeout
    export_timeout: "30s"

  # 7.2 Container Health Probes (K8s /livez and /readyz)
  health:
    # Enable health check endpoints on the unified HTTP server
    enabled: true
    # Liveness probe endpoint path
    live_path: "/livez"
    # Readiness probe endpoint path (verifies Queue, SMTP, and Runtime health)
    ready_path: "/readyz"
    # Timeout per readiness check execution
    check_timeout: "5s"

  # 7.3 Performance Profiling (Pprof)
  pprof:
    # Enable runtime pprof profiling endpoints on the unified HTTP server
    enabled: false
    # Profiler endpoint root path
    path: "/debug/pprof"
    # Enable mutex contention profiling
    profile_mutex: false
    # Enable goroutine block profiling
    profile_block: false
